<Window x:Class="GridExemplarWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GridExemplarWPF"
        mc:Ignorable="d"
        Title="Grid Selection Example" Height="650" Width="900">

    <!-- 
        DockPanel is the main container - it allows us to 'dock' controls to edges
        This is useful for creating a typical application layout with menu, toolbars, etc.
        LastChildFill="True" means the last child element fills remaining space
    -->
    <DockPanel LastChildFill="True">

        <!-- 
            Menu bar docked to the top
            Menus provide organized access to commands and are standard in desktop apps
            DockPanel.Dock="Top" attaches this to the top edge
        -->
        <Menu DockPanel.Dock="Top">
            <!-- 
                Each MenuItem can contain sub-items to create dropdown menus
                The Header property is what the user sees
                Click event handlers will be defined in the code-behind
            -->
            <MenuItem Header="_File">
                <!-- Underscore creates keyboard shortcut: Alt+F opens this menu -->
                <MenuItem Header="_Clear Selection" Click="ClearSelection_Click"/>
                <MenuItem Header="_Reset Grid" Click="ResetGrid_Click"/>
                <Separator/>
                <!-- Separator creates a horizontal line to group related items -->
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Toggle Grid Lines" Click="ToggleGridLines_Click"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 
            Control panel docked to the right side
            This shows how to add buttons and controls alongside the main canvas
            Width="180" gives enough space for labels and textboxes
        -->
        <StackPanel DockPanel.Dock="Right" Width="180" Background="LightGray" Margin="5">
            <!-- 
                StackPanel arranges children vertically (default) or horizontally
                This makes it easy to create a list of buttons or controls
                Background and Margin help visually separate it from the canvas
            -->

            <!-- TextBlock for a heading - shows information but isn't interactive -->
            <TextBlock Text="Grid Settings" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       Margin="5"
                       HorizontalAlignment="Center"/>

            <!-- 
                Grid dimension controls
                These allow the user to change the size of the grid dynamically
                Label/TextBox pairs are a common pattern for input forms
            -->
            <TextBlock Text="Grid Width (columns):" 
                       Margin="5,10,5,2"/>
            <!-- 
                TextBox allows user input
                x:Name lets us access this control in code-behind
                Text is initialized to the default value
            -->
            <TextBox x:Name="WidthTextBox" 
                     Text="10" 
                     Margin="5,0,5,5"
                     Padding="3"/>

            <TextBlock Text="Grid Height (rows):" 
                       Margin="5,5,5,2"/>
            <TextBox x:Name="HeightTextBox" 
                     Text="10" 
                     Margin="5,0,5,5"
                     Padding="3"/>

            <!-- 
                Button to apply the new grid dimensions
                This separates input (textboxes) from action (button)
                User can change values and then choose when to apply them
            -->
            <Button Content="Apply Grid Size" 
                    Margin="5"
                    Padding="5"
                    Click="ApplyGridSize_Click"/>

            <!-- Separator to visually group controls -->
            <Separator Margin="5,10,5,10"/>

            <TextBlock Text="Controls" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       Margin="5"
                       HorizontalAlignment="Center"/>

            <!-- 
                Buttons trigger actions when clicked
                Margin adds spacing between buttons for better UI
                Each button has a Click event that links to a method in code-behind
            -->
            <Button Content="Clear Selection" 
                    Margin="5" 
                    Padding="5"
                    Click="ClearSelection_Click"/>

            <Button Content="Randomise Walls" 
                    Margin="5"
                    Padding="5"
                    Click="RandomiseWalls_Click"/>

            <Button Content="Select All" 
                    Margin="5"
                    Padding="5"
                    Click="SelectAll_Click"/>

            <!-- Separator to group related controls visually -->
            <Separator Margin="5,10,5,10"/>

            <!-- Label and TextBlock to display information -->
            <TextBlock Text="Selected Squares:" 
                       Margin="5,5,5,2"
                       FontWeight="Bold"/>

            <!-- 
                x:Name allows us to reference this control in code-behind
                We'll update this TextBlock to show the count of selected squares
            -->
            <TextBlock x:Name="SelectedCountLabel" 
                       Text="0" 
                       Margin="5,2,5,5"
                       HorizontalAlignment="Center"
                       FontSize="18"/>
        </StackPanel>

        <!-- 
            Canvas fills the remaining space (because LastChildFill="True")
            This is where we'll draw the grid of squares
            Border adds a visual frame around the canvas
        -->
        <Border BorderBrush="DarkGray" BorderThickness="1" Margin="5">
            <Canvas x:Name="DrawingCanvas" 
                    Background="White"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
            </Canvas>
        </Border>

    </DockPanel>
</Window>